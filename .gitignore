# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/

# YOLO & PyTorch model weight files (do not commit models to GitHub)
*.pt
*.pth
*.onnx
*.engine
*.tflite
models/*.pt
models/*.onnx
models/*.engine
models/*.tflite

# Ultralytics runs & local caches
runs/
.ultralytics/

# Datasets (do not commit dataset images to GitHub)
dataset/low_density/*
dataset/medium_density/*
dataset/high_density/*
!dataset/**/.gitkeep

# Output images and reports (do not commit generated outputs to GitHub)
output/low_density/*
output/medium_density/*
output/high_density/*
output/*.csv
!output/**/.gitkeep

# Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
